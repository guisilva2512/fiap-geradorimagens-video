{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "title": "Requisicoes por segundo",
      "type": "timeseries",
      "targets": [{"expr": "sum by (service) (rate(fiap_http_requests_total[5m]))", "legendFormat": "{{service}}", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "title": "Latencia HTTP p95",
      "type": "timeseries",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (service, le) (rate(fiap_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service}}", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "title": "Mensagens do worker",
      "type": "timeseries",
      "targets": [{"expr": "sum by (status) (increase(fiap_worker_messages_total[1h]))", "legendFormat": "{{status}}", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "title": "Duracao do processamento",
      "type": "timeseries",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (service, le) (rate(fiap_worker_processing_duration_seconds_bucket[5m])))", "legendFormat": "{{service}}", "refId": "A"}]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["fiap", "observability"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "FIAP - Observabilidade",
  "uid": "fiap-observability",
  "version": 1
}
